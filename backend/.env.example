# ==============================================================================
# Aurel Home Backend - Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NOTE: Never commit your actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Aurel Home API"
DEBUG=true

# Database Configuration (PostgreSQL / Supabase)
# For Supabase PostgreSQL, use the URI from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or direct: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# CORS Allowed Origins (comma-separated list for Next.js frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Administrative API Key for protecting write operations (POST, PATCH, DELETE)
# and for running local automation/scripts.
# Supply this in the `X-Admin-API-Key` request header for write operations.
ADMIN_API_KEY=your-temporary-admin-secret-key-change-me

# Supabase Authentication & Security Configuration
# Project URL: https://[PROJECT_REF].supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase JWT Secret: Found in Project Settings -> API -> JWT Settings -> JWT Secret
# Used for server-side verification of Supabase access tokens (HMAC-SHA256).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Supabase Anon Key: Project Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Razorpay Test Mode Configuration (NEVER commit live secrets or real credentials)
# Razorpay Dashboard -> Settings -> API Keys -> Generate Key (Test Mode)
# Key format: rzp_test_[14 alphanumeric characters]
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret-here
# Optional Webhook Secret for Razorpay payment webhooks
RAZORPAY_WEBHOOK_SECRET=your-razorpay-test-webhook-secret-here
