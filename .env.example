# Aurel Home Frontend - Environment Configuration Template
# Copy to .env.local for local development.

# FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Public API
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Project Settings -> API -> Project API keys -> anon public (Safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay Test Mode Key (Test Key ID only - safe for browser exposure)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
